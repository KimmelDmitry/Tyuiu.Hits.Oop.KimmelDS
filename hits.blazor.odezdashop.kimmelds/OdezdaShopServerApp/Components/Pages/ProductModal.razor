@using System.ComponentModel.DataAnnotations
@using OdezdaShopServerApp.Core.Entities
@using OdezdaShopServerApp.Core.Interfaces.Services
@using OdezdaShopServerApp.VerticalSlices.Dto
@using OdezdaShopServerApp.VerticalSlices;
@inject IProductService ProductService
@inject IImageStorageService ImageStorageService
@inject ICategoryService CategoryService
@inject IJSRuntime JS

<div class="modal-backdrop" style="display:@(IsOpen ? "block" : "none")" @onclick="HandleBackdropClick"></div>

<div class="product-modal" style="display:@(IsOpen ? "block" : "none")" role="dialog" aria-modal="true">
    <div class="modal-card">
        <div class="modal-header">
            <h4>@(IsEdit ? "Редактировать товар" : "Создать товар")</h4>
            <button class="close-btn" @onclick="Close" aria-label="Close">✕</button>
        </div>

        
        <EditForm Model="Model" OnValidSubmit="HandleSubmit" FormName="@FormName">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="grid">
                <div class="form-group">
                    <label>Название</label>
                    <InputText class="form-control"
                               @bind-Value="Model.Name" />
                </div>

                <div class="form-group">
                    <label>Категория</label>
                    <select class="form-control"
                            @bind="Model.CategoryId">
                        <option value="">-- выберите --</option>
                        @foreach (var c in Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Цена</label>
                    <InputNumber class="form-control"
                                 @bind-Value="Model.Price" />
                </div>

                <div class="form-group">
                    <label>Кол-во</label>
                    <InputNumber class="form-control"
                                 @bind-Value="Model.Stock" />
                </div>

                <div class="form-group full">
                    <label>Описание</label>
                    <InputTextArea class="form-control textarea"
                                   @bind-Value="Model.Description" />
                </div>

                <div class="form-group image-block">
                    <label>Изображение</label>
                    <InputFile OnChange="OnFileChanged" />

                    @if (!string.IsNullOrWhiteSpace(PreviewImageUrl))
                    {
                        <div class="preview">
                            <img src="@PreviewImageUrl" alt="preview" />
                        </div>
                    }

                    @if (IsEdit && !Model.IsActive)
                    {
                        <button class="btn btn-warning mt-2"
                                type="button"
                                @onclick="Activate">
                            Активировать
                        </button>
                    }
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn btn-secondary" type="button" @onclick="Close">
                    Отмена
                </button>

                <button class="btn btn-primary"
                        type="submit">
                    @(IsEdit ? "Сохранить" : "Создать")
                </button>
            </div>
        </EditForm>

    </div>
</div>

<style>
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.38); z-index: 40; }
    .product-modal { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 50; width: 94%; max-width: 820px; padding: 0.5rem; }
    .modal-card { background: #fff; border-radius: 10px; box-shadow: 0 10px 30px rgba(2,6,23,0.12); padding: 1rem; border: 1px solid rgba(0,0,0,0.04); }
    .modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem; }
    .close-btn { background:transparent; border:0; font-size:1.1rem; cursor:pointer; }
    .grid { display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem; }
    .form-group { display:flex; flex-direction:column; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label { font-size:0.85rem; margin-bottom:0.35rem; color:#444; }
    .textarea { min-height: 90px; resize: vertical; }
    .image-block .preview { margin-top:0.5rem; }
    .image-block img { width:96px; height:96px; object-fit:cover; border-radius:6px; border:1px solid #e5e7eb; }
    .modal-actions { display:flex; justify-content:flex-end; gap:0.5rem; margin-top:0.75rem; }
    @@media (max-width:640px) { .grid { grid-template-columns: 1fr; } .product-modal { width: 96%; } }
</style>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool IsOpen { get; set; }
    private bool IsEdit { get; set; }
    private string FormName { get; } = $"productForm-{Guid.NewGuid():N}";

    private CreateOrEditModel Model { get; set; } = new();
    private List<CategoryDto> Categories { get; set; } = new();

    private string? PreviewImageUrl;
    private byte[]? pendingFileBytes;
    private string? pendingFileName;

    protected override async Task OnInitializedAsync()
    {
        var cats = await CategoryService.GetAllAsync();
        Categories = cats.ToList();
    }

    public void OpenCreate()
    {
        IsEdit = false;
        Model = new CreateOrEditModel();
        PreviewImageUrl = null;
        pendingFileBytes = null;
        pendingFileName = null;
        IsOpen = true;
        StateHasChanged();
    }

    public async Task OpenEditAsync(Guid id)
    {
        IsEdit = true;
        var product = await ProductService.GetAsync(id);
        if (product == null)
        {
            await JS.InvokeVoidAsync("alert", "Товар не найден");
            return;
        }

        Model = new CreateOrEditModel
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            Stock = product.Stock,
            CategoryId = product.CategoryId,
            ImagePath = product.ImagePath,
            IsActive = product.IsActive
        };

        PreviewImageUrl = product.ImagePath; // относительный путь из БД (/images/...)
        pendingFileBytes = null;
        pendingFileName = null;
        IsOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        IsOpen = false;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (IsEdit)
            {
                if (!Model.Id.HasValue) throw new InvalidOperationException("Id required for edit.");

                // Получаем сущность, обновляем поля
                var product = await ProductService.GetAsync(Model.Id.Value);
                if (product == null) throw new InvalidOperationException("Product not found.");

                product.Name = Model.Name;
                product.Description = Model.Description;
                product.Price = Model.Price;
                product.Stock = Model.Stock;
                product.CategoryId = Model.CategoryId;

                if (pendingFileBytes != null && pendingFileName != null)
                {
                    // Передаём оба аргумента: имя файла и байты — ImageStorageService внутри ProductService может использовать их
                    await ProductService.UpdateAsync(product, pendingFileName, pendingFileBytes);
                }
                else
                {
                    await ProductService.UpdateAsync(product);
                }
            }
            else
            {
                // CreateAsync(string name, decimal price, Guid categoryId, int stock, string? description, string? imageFileName, byte[]? imageBytes)
                await ProductService.CreateAsync(
                    Model.Name,
                    Model.Price,
                    Model.CategoryId,
                    Model.Stock,
                    Model.Description,
                    pendingFileName,
                    pendingFileBytes);
            }

            await OnSaved.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            await JS.InvokeVoidAsync("alert", "Ошибка при сохранении: " + ex.Message);
        }
    }

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Ограничение размера и валидация формата можно добавить здесь
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        pendingFileBytes = ms.ToArray();
        pendingFileName = file.Name;

        // Превью
        try
        {
            var base64 = Convert.ToBase64String(pendingFileBytes);
            var mime = file.ContentType ?? "image/*";
            PreviewImageUrl = $"data:{mime};base64,{base64}";
        }
        catch
        {
            PreviewImageUrl = null;
        }
    }

    private void HandleBackdropClick()
    {
        Close();
    }

    private async Task Activate()
    {
        if (!Model.Id.HasValue) return;

        var product = await ProductService.GetAsync(Model.Id.Value);
        if (product == null) return;

        product.IsActive = true;

        await ProductService.UpdateAsync(product);

        Model.IsActive = true; // чтобы кнопка пропала
        await OnSaved.InvokeAsync();
    }


    private class CreateOrEditModel
    {
        public Guid? Id { get; set; }

        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        [Range(0, double.MaxValue)]
        public decimal Price { get; set; }

        public int Stock { get; set; }

        public Guid CategoryId { get; set; }

        public string? ImagePath { get; set; }

        public bool IsActive { get; set; }   
    }
}
